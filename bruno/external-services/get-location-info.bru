meta {
  name: get-location-info
  type: http
  seq: 3
}

get {
  url: http://ip-api.com/json/
  body: json
  auth: inherit
}

script:post-response {
  if (res.getStatus() == 200) {
    bru.setEnvVar("longitude", res.body.lon);
    bru.setEnvVar("latitide", res.body.lat);
    bru.setEnvVar("timezone", res.body.timezone);
  }
  
}

settings {
  encodeUrl: true
}
